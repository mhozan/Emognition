# Emognition (PsychoPy port) — high-level, human-edited dependencies.
# This is the "what we asked for"; requirements.txt is the "what we got" lockfile.
#
# Reproduce the exact known-good environment (what CI and the builds use):
#   pip install --no-deps -r requirements.txt
# requirements.txt is the lockfile; this file is only the human-level intent.
# Do NOT `pip install -r requirements.in`: resolving psychopy's metadata would
# pull in wxPython (see below).
#
# Why psychopy is installed with --no-deps: its metadata hard-requires wxPython,
# which (a) has no PyPI wheel on Linux, (b) is only used by the PsychoPy Builder/Coder
# IDE — NOT by the experiment runtime — and (c) bloats PyInstaller bundles. We build
# our own UI on PyQt6 (which PsychoPy already depends on), so wx is dead weight.

# --- The experiment engine (timing, audio, visual, data) ---
# psychopy==2026.1.3          # pinned in requirements.txt; installed with --no-deps

# --- Report generation (replaces MATLAB's print -dpdf / writematrix) ---
fpdf2                          # PDF reports  (was: MATLAB print -dpdf)
defusedxml                     # optional fpdf2 dep: SVG sanitization (silences a warning)
openpyxl                       # Excel reports (was: MATLAB writecell/writematrix)
matplotlib                     # confusion-matrix figure for the PDF

# --- Participant-window background pictures (decode, fit, import) ---
pillow                         # already a psychopy dependency; used directly by emognition.imaging
numpy                          # ditto; gradient rendering and audio envelopes

# --- Audio preprocessing / calibration (loudness normalize + trim silence) ---
pyloudnorm                     # perceived loudness, ITU-R BS.1770 (LUFS)
# soundfile is already pulled in by psychopy (wav read/write)

# --- Packaging (the double-click executable) ---
pyinstaller                    # build per-OS bundles: scripts/build_executable.sh
